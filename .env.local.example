# ─────────────────────────────────────────────────
# 내 머리속 카드뉴스 — 환경변수 설정
# 이 파일을 복사해서 .env.local 로 저장하세요
# ─────────────────────────────────────────────────

# [기본] Gemini API 키 (무료 발급: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=여기에_Gemini_API_키_입력

# [선택] Claude API 키 (더 높은 품질, 유료: https://console.anthropic.com/)
ANTHROPIC_API_KEY=여기에_Claude_API_키_입력

# [선택] Pexels API 키 (배경 이미지 검색, 완전 무료: https://www.pexels.com/api/)
PEXELS_API_KEY=여기에_Pexels_API_키_입력

# ─────────────────────────────────────────────────
# 로그인 기능 — Firebase + 카카오 + 네이버
# ─────────────────────────────────────────────────

# [Firebase Client SDK — 공개 가능]
# Firebase 콘솔 → 프로젝트 설정 → 일반 탭 → 웹 앱 선택
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# [Firebase Admin SDK — 비공개, 서버 전용]
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성"
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# private_key는 JSON의 값을 그대로 복사하고 줄바꿈은 \n 유지하여 따옴표로 감싸기
FIREBASE_ADMIN_PRIVATE_KEY=""

# [카카오 로그인]
# https://developers.kakao.com → 애플리케이션 추가
# Redirect URI: https://my-cardnews-app.vercel.app/api/auth/kakao/callback
NEXT_PUBLIC_KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# [네이버 로그인]
# https://developers.naver.com/apps → Application 등록
# Callback URL: https://my-cardnews-app.vercel.app/api/auth/naver/callback
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [사이트 URL — 프로덕션]
NEXT_PUBLIC_SITE_URL=https://my-cardnews-app.vercel.app
